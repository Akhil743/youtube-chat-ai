# Required: Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Exact browser origins allowed by CORS (comma-separated).
# http://localhost:<any port> and http://127.0.0.1:<any port> are always allowed.
ALLOWED_ORIGINS=https://akhilrajs.com

# Abuse guards.
# DAILY_LLM_CAP: model calls (answers + new-video indexing) per UTC day, process-wide.
DAILY_LLM_CAP=500
# Per client IP (CF-Connecting-IP, else first X-Forwarded-For hop, else socket address).
LOAD_RATE_LIMIT=10/minute
CHAT_RATE_LIMIT=20/minute
# Reject transcripts longer than this many characters (~4-5 hours of speech).
MAX_TRANSCRIPT_CHARS=300000

# Retrieval
MAX_VIDEOS_CACHED=50
RETRIEVAL_K=5
CHUNK_TARGET_CHARS=500
# Index the bundled sample videos at startup (set 0 to skip).
PRELOAD_SAMPLES=1

# Models. List prices (USD per 1M tokens) live in app/pricing.py and can be overridden:
CHAT_MODEL=gemini-2.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
# PRICE_GEMINI_2_5_FLASH_LITE_INPUT=0.10
# PRICE_GEMINI_2_5_FLASH_LITE_OUTPUT=0.40
# PRICE_GEMINI_EMBEDDING_001_INPUT=0.15
# PRICING_AS_OF=2026-10-29

# Fallback transcript proxy (transcript-worker/), used when YouTube blocks the server.
# TRANSCRIPT_WORKER_URL=https://yt-transcript-proxy.<your-subdomain>.workers.dev/
